rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    // Categories are public-read; only admins can write.
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Provider profiles: public-read, owner-write.
    match /providers/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // Service requests: public-read and public-create.
    // Updates restricted to a safe subset of fields (including matchCount).
    // Deletes are forbidden.
    match /requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isPublic', 'requesterWhatsapp', 'requesterEmail', 'status', 'updatedAt', 'matchCount']);
      allow delete: if false;
    }

    // matches — client writes after TF.js matching; read is public so guests can see their results.
    // Guards:
    //   1. Written requestId field must match the document path (prevents cross-document poisoning).
    //   2. Cannot overwrite a document already in 'completed' status (prevents suppressing results).
    //   3. sessionToken in the match document must match the parent request's sessionToken
    //      (prevents a foreign browser tab from writing results for a request it didn't create).
    match /matches/{requestId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['requestId', 'status', 'results', 'processedAt', 'createdAt', 'sessionToken'])
        && request.resource.data.requestId == requestId
        && (!exists(/databases/$(database)/documents/matches/$(requestId))
            || resource.data.status != 'completed')
        && get(/databases/$(database)/documents/requests/$(requestId)).data.sessionToken
             == request.resource.data.sessionToken;
    }
  }
}
